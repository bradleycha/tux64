diff --git a/arch/mips/n64/tux64-boot.c b/arch/mips/n64/tux64-boot.c
new file mode 100644
index 000000000..ff8eb9936
--- /dev/null
+++ b/arch/mips/n64/tux64-boot.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * tux64-boot.c: Kernel support for extended boot information provided by tux64-boot.
+ *
+ * Copyright (C) 2026 Chase Bradley <bradleycha@proton.me>
+ */
+
+#include <linux/init.h>
+#include <linux/initrd.h>
+#include <linux/memblock.h>
+#include <linux/string.h>
+#include <linux/random.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+
+#include <asm/bootinfo.h>
+
+#include "tux64-boot.h"
+
+#define MI_VERSION_ADDRESS CKSEG1ADDR(0x04300004)
+
+#define N64_PROC_FS_ENUM_CHARACTERS_MAX 7
+#define N64_PROC_FS_HEX8_CHARACTERS_MAX 3
+#define N64_PROC_FS_HEX32_CHARACTERS_MAX 9
+
+struct n64_boot_metadata_procfs
+{
+	char mi_version[N64_PROC_FS_HEX32_CHARACTERS_MAX];
+	char console_type[N64_PROC_FS_ENUM_CHARACTERS_MAX];
+	char rom_type[N64_PROC_FS_ENUM_CHARACTERS_MAX];
+	char reset_type[N64_PROC_FS_ENUM_CHARACTERS_MAX];
+	char rom_cic_seed[N64_PROC_FS_HEX8_CHARACTERS_MAX];
+	char pif_rom_version[N64_PROC_FS_HEX8_CHARACTERS_MAX];
+};
+
+extern unsigned int __initdata n64cart_init_start;
+extern unsigned int __initdata n64cart_init_size;
+
+void __init tux64_prom_init(void);
+void __init tux64_platform_init(void);
+void __init tux64_plat_mem_setup(void);
+
+static void __initdata *initrd_ptr = 0;
+static unsigned long __initdata initrd_bytes = 0;
+static const char __initdata *cmdline = NULL;
+static uint32_t __initdata system_memory;
+
+struct n64_boot_metadata n64_boot_metadata;
+
+struct tux64_boot_resource
+{
+	uint32_t address;
+	uint32_t bytes;
+};
+
+struct tux64_boot_args
+{
+	uint32_t initrd_address;
+	uint32_t initrd_bytes;
+	uint32_t rootfs_cart_address;
+	uint32_t rootfs_bytes;
+	uint32_t command_line_address;
+	uint32_t total_memory;
+	uint32_t rng_seed;
+	uint32_t metadata;
+};
+
+static void __init tux64_load_boot_args(struct tux64_boot_args *args)
+{
+	const struct tux64_boot_args *args_raw;
+
+	args_raw = (const struct tux64_boot_args *)CKSEG0ADDR(be32_to_cpu(fw_arg0));
+
+	/*
+	 * args_raw is aligned by the bootloader.  we leave rng_seed in big-endian
+	 * form since we will be using it as a byte buffer for random init.
+	 */
+	args->initrd_address		= be32_to_cpu(args_raw->initrd_address);
+	args->initrd_bytes		= be32_to_cpu(args_raw->initrd_bytes);
+	args->rootfs_cart_address	= be32_to_cpu(args_raw->rootfs_cart_address);
+	args->rootfs_bytes		= be32_to_cpu(args_raw->rootfs_bytes);
+	args->command_line_address	= be32_to_cpu(args_raw->command_line_address);
+	args->total_memory		= be32_to_cpu(args_raw->total_memory);
+	args->metadata			= be32_to_cpu(args_raw->metadata);
+	args->rng_seed			= args_raw->rng_seed;
+}
+
+static void __init tux64_prom_init_cmdline(void)
+{
+	if (!cmdline)
+		return;
+
+#ifdef CONFIG_CMDLINE_BOOL
+	strscpy(arcs_cmdline, CONFIG_CMDLINE, COMMAND_LINE_SIZE);
+#ifndef CONFIG_CMDLINE_OVERRIDE
+	if (cmdline[0] != '\0')
+		strlcat(arcs_cmdline, " ", COMMAND_LINE_SIZE);
+#endif
+#endif
+
+#ifndef CONFIG_CMDLINE_OVERRIDE
+	strlcat(arcs_cmdline, cmdline, COMMAND_LINE_SIZE);
+#endif
+}
+
+static void __init tux64_load_boot_metadata(uint32_t metadata, uint32_t mi_version)
+{
+	n64_boot_metadata.mi_version		= mi_version;
+	n64_boot_metadata.console_type		= metadata & 0x3;
+	n64_boot_metadata.rom_type		= (metadata >> 2) & 0x1;
+	n64_boot_metadata.reset_type		= (metadata >> 3) & 0x1;
+	n64_boot_metadata.rom_cic_seed		= (metadata >> 4) & 0xff;
+	n64_boot_metadata.pif_rom_version	= (metadata >> 12) & 0xff;
+}
+
+static void __init tux64_prom_init_args(void)
+{
+	struct tux64_boot_args args;
+
+	tux64_load_boot_args(&args);
+
+	if (args.initrd_bytes != 0)
+	{
+		initrd_ptr = (void *)CKSEG0ADDR(args.initrd_address);
+		initrd_bytes = args.initrd_bytes;
+	}
+	#ifdef CONFIG_N64CART
+	if (args.rootfs_bytes != 0) {
+		n64cart_init_start = args.rootfs_cart_address;
+		n64cart_init_size = args.rootfs_bytes;
+	}
+	#endif
+	if (args.command_line_address != 0)
+	{
+		cmdline = (const char *)CKSEG0ADDR(args.command_line_address);
+	}
+
+	system_memory = args.total_memory;
+	add_bootloader_randomness(&args.rng_seed, sizeof(args.rng_seed));
+	tux64_load_boot_metadata(args.metadata, readl_be(MI_VERSION_ADDRESS));
+}
+
+void __init tux64_prom_init(void)
+{
+	tux64_prom_init_args();
+	tux64_prom_init_cmdline();
+}
+
+#ifdef CONFIG_TUX64_PROC_FS
+static int tux64_procfs_show_string(struct seq_file *m, void *v)
+{
+	const char *s;
+
+	s = (const char *)m->private;
+	seq_puts(m, s);
+
+	return 0;
+}
+
+static struct n64_boot_metadata_procfs n64_boot_metadata_procfs;
+
+static void __init tux64_procfs_format_enum(char buf[], unsigned v, const char *s)
+{
+	sprintf(buf, "%x %s", v, s);
+}
+
+static void __init tux64_procfs_format_hex8(char buf[], unsigned x)
+{
+	sprintf(buf, "%02x", x);
+}
+
+static void __init tux64_procfs_format_hex32(char buf[], unsigned x)
+{
+	sprintf(buf, "%08x", x);
+}
+
+static void __init tux64_procfs_init_boot_metadata(struct n64_boot_metadata_procfs *md)
+{
+	const char *s_console_type;
+	const char *s_rom_type;
+	const char *s_reset_type;
+
+	/*
+	 * We do all of the complex string formatting all at once because this
+	 * data should never change.  Therefore, we can do it all as an __init
+	 * function, then after booting we only use the simple seq_puts(...)
+	 * code.
+	 */
+
+	switch (n64_boot_metadata.console_type)
+	{
+		case N64_CONSOLE_TYPE_PAL:
+			s_console_type = "pal";
+			break;
+
+		case N64_CONSOLE_TYPE_NTSC:
+			s_console_type = "ntsc";
+			break;
+
+		case N64_CONSOLE_TYPE_MPAL:
+			s_console_type = "mpal";
+			break;
+
+		case N64_CONSOLE_TYPE_IQUE:
+			s_console_type = "ique";
+			break;
+	}
+
+	switch (n64_boot_metadata.rom_type)
+	{
+		case N64_ROM_TYPE_CART:
+			s_rom_type = "cart";
+			break;
+
+		case N64_ROM_TYPE_64DD:
+			s_rom_type = "64dd";
+			break;
+	}
+
+	switch (n64_boot_metadata.reset_type)
+	{
+		case N64_RESET_TYPE_HARD:
+			s_reset_type = "hard";
+			break;
+
+		case N64_RESET_TYPE_SOFT:
+			s_reset_type = "soft";
+			break;
+	}
+
+	tux64_procfs_format_hex32(md->mi_version, n64_boot_metadata.mi_version);
+	tux64_procfs_format_enum(md->console_type, n64_boot_metadata.console_type, s_console_type);
+	tux64_procfs_format_enum(md->rom_type, n64_boot_metadata.rom_type, s_rom_type);
+	tux64_procfs_format_enum(md->reset_type, n64_boot_metadata.reset_type, s_reset_type);
+	tux64_procfs_format_hex8(md->rom_cic_seed, n64_boot_metadata.rom_cic_seed);
+	tux64_procfs_format_hex8(md->pif_rom_version, n64_boot_metadata.pif_rom_version);
+}
+
+static void __init tux64_procfs_init(void)
+{
+	struct proc_dir_entry *root;
+
+	tux64_procfs_init_boot_metadata(&n64_boot_metadata_procfs);
+
+	root = proc_mkdir("n64", NULL);
+	if (!root) {
+		pr_err("Failed to create base directory for /proc/n64");
+		return;
+	};
+
+	proc_create_single_data("mi_version", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.mi_version);
+	proc_create_single_data("console_type", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.console_type);
+	proc_create_single_data("reset_type", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.reset_type);
+	proc_create_single_data("rom_type", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.rom_type);
+	proc_create_single_data("rom_cic_seed", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.rom_cic_seed);
+	proc_create_single_data("pif_rom_version", S_IRUGO, root, tux64_procfs_show_string, n64_boot_metadata_procfs.pif_rom_version);
+}
+#else
+static void __init tux64_procfs_init(void)
+{
+}
+#endif
+
+void __init tux64_platform_init(void)
+{
+	tux64_procfs_init();
+}
+
+static void __init tux64_plat_mem_setup_address_space(void)
+{
+	memblock_add(0x0, system_memory);
+}
+
+#if CONFIG_BLK_DEV_INITRD
+static int __init tux64_initrd_page_align(void)
+{
+	void *initrd_ptr_relocated;
+
+	if (PAGE_ALIGNED(initrd_ptr))
+		return 0;
+
+	initrd_ptr_relocated = memblock_alloc(initrd_bytes, PAGE_SIZE);
+	if (!initrd_ptr_relocated)
+		return -ENOMEM;
+
+	memmove(initrd_ptr_relocated, initrd_ptr, initrd_bytes);
+	initrd_ptr = initrd_ptr_relocated;
+
+	return 0;
+}
+
+static void __init tux64_plat_mem_setup_initrd(void)
+{
+	if (!initrd_ptr)
+		return;
+
+	if (tux64_initrd_page_align() < 0)
+	{
+		pr_err("Unable to relocate initrd to page boundary");
+		return;
+	}
+
+	initrd_start	= (unsigned long)initrd_ptr;
+	initrd_end	= (unsigned long)initrd_ptr + initrd_bytes;
+}
+#else
+static void __init tux64_plat_mem_setup_initrd(void)
+{
+}
+#endif
+
+void __init tux64_plat_mem_setup(void)
+{
+	tux64_plat_mem_setup_address_space();
+	tux64_plat_mem_setup_initrd();
+}
diff --git a/arch/mips/n64/tux64-boot.h b/arch/mips/n64/tux64-boot.h
new file mode 100644
index 000000000..ccc0e736b
--- /dev/null
+++ b/arch/mips/n64/tux64-boot.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Data and structures specific to tux64-boot.
+ */
+
+#ifndef _TUX64_BOOT_H
+#define _TUX64_BOOT_H
+
+#include <linux/types.h>
+
+enum n64_console_type
+{
+	N64_CONSOLE_TYPE_PAL = 0,
+	N64_CONSOLE_TYPE_NTSC = 1,
+	N64_CONSOLE_TYPE_MPAL = 2,
+	N64_CONSOLE_TYPE_IQUE = 3
+};
+
+enum n64_rom_type
+{
+	N64_ROM_TYPE_CART = 0,
+	N64_ROM_TYPE_64DD = 1
+};
+
+enum n64_reset_type
+{
+	N64_RESET_TYPE_HARD = 0,
+	N64_RESET_TYPE_SOFT = 1
+};
+
+/*
+ * Information about the N64 hardware enumerated by the bootloader.
+ */
+struct n64_boot_metadata
+{
+	uint32_t mi_version;
+	enum n64_console_type console_type;
+	enum n64_rom_type rom_type;
+	enum n64_reset_type reset_type;
+	uint8_t rom_cic_seed;
+	uint8_t pif_rom_version;
+};
+
+#if CONFIG_MIPS_TUX64
+extern struct n64_boot_metadata n64_boot_metadata;
+#endif
+
+#endif /* _TUX64_BOOT_H */
